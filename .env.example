# Copy to .env for local testing (netlify dev picks it up automatically).
# In production, set these in Netlify: Site settings -> Environment variables.

# Azure app registration (Phase 3 setup) — client-credentials access to the booking mailbox's calendar
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX_UPN=NestorOrd@LumixStudio.onmicrosoft.com

# Shared secret the ElevenLabs webhook tool must send as header: x-lumix-webhook-secret
WEBHOOK_SECRET=
